# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Credential for AGENT_RUNTIME=claude-code. Set exactly one of these — Claude
# Code ranks the API key higher, so setting both silently ignores the token.
#   CLAUDE_CODE_OAUTH_TOKEN: draws on a Claude Pro/Max/Team/Enterprise
#     subscription. Generate with `claude setup-token` (valid one year).
#   ANTHROPIC_API_KEY: a Claude Console key, billed against your Console
#     credit balance — separate from any subscription.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex
# Claude Code's config/session/credentials directory (CLAUDE_CONFIG_DIR) and
# CLI binary path — only used when AGENT_RUNTIME=claude-code below.
CLAUDE_CODE_HOME=/app/claude-home
CLAUDE_CODE_BIN=claude
# How Claude Code answers its own permission prompts. Headless runs have
# nobody to approve them, so this is not cosmetic:
#   default          - denies every command and every file write; the agent
#                      can only read, and looks like it chose to do nothing
#   acceptEdits      - file edits go through, commands are still denied
#   bypassPermissions - everything goes through; only defensible with
#                      RUNTIME_PROVIDER=container, where the container is the
#                      boundary. Under local-process it hands the agent your
#                      own account.
# Claude Code has no sandbox of its own, so unlike CODEX_SANDBOX_MODE below
# this setting grants access rather than confining it.
CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Which Agent runtime CLI to run turns through: codex (default) or claude-code.
# Server-wide, not per-Agent — see README.md#agent-runtime.
AGENT_RUNTIME=codex

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# --- Glass Box auditing -----------------------------------------------------
# Set to false to stop auditing entirely. Auditing also stays off while Ark is
# unconfigured, though the deterministic checks below still run.
AUDIT_ENABLED=true
# An intent change takes effect as soon as it is classified; there is no
# confirmation step. It is reversible instead, through
# POST /api/agents/:id/intent/revert, and the Playground shows the timeline.
#
# Set these to two DIFFERENT models. Every audit fallback is guarded on the two
# differing, so a single value for both leaves no degraded path and one failure
# loses the step's judged verdict outright. The server warns at boot if they
# match. Both must be activated on your Ark account and answer within 60 seconds.
# An unactivated model returns ModelNotOpen and every audit degrades to the
# fallback; a slow reasoning endpoint times out and every audit fails. Check a
# candidate with a trivial prompt before setting it here.
AUDIT_SECURITY_MODEL=gpt-oss-120b-250805
AUDIT_INTENT_MODEL=deepseek-v4-flash-ga-260731
# A step's three always-on checks are asked the same evidence, so with this on
# the auditor caches it with Ark and only the first of them pays for it. Off by
# default: the write and the hour of residency are billed whether the hits
# materialise or not, and not every endpoint holds a context. Turn it on, run
# one agent, and read cachedTokens on the auditor's trace before leaving it on.
AUDIT_PROMPT_CACHE=false
# Seconds, 3600 to 604800. Ark's floor is an hour; a step's checks are done in
# seconds, so the cache outlives its use no matter what is set here.
AUDIT_PROMPT_CACHE_TTL=3600
# Comma-separated hostnames the agent may reach. Leave unset to disable the
# network policy check; set it empty to deny every destination. A leading dot
# opts a whole subtree in, so ".github.com" also covers api.github.com.
#
# Unset means no destination is ever reported, which the server warns about at
# boot. This reports, it does not block: see the limitations in
# docs/GLASS_BOX.md for what a text-derived check cannot see.
AUDIT_NETWORK_WHITELIST=api.github.com,.githubusercontent.com,registry.npmjs.org
